{
  "name": "@mause/www-sacred",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mause/www-sacred.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "SRCL is an open-source React component and style repository that helps you build web applications, desktop applications, and static websites with terminal aesthetics.",
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "version": "1.1.26",
  "type": "module",
  "files": [
    "package.json",
    "./dist/srcl.js",
    "./dist/srcl.d.ts",
    "global.css",
    "global-fonts.css",
    "./global.css",
    "./global-fonts.css",
    "./dist/components.js",
    "./dist/components.d.ts",
    "dist"
  ],
  "exports": {
    "./global.css": {
      "import": "./global.css"
    },
    "./global-fonts.css": {
      "import": "./global-fonts.css"
    },
    "./www-sacred.css": {
      "import": "./dist/www-sacred.css"
    },
    ".": {
      "types": "./dist/srcl.d.ts",
      "import": "./dist/srcl.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.js"
    }
  },
  "scripts": {
    "dev": "next -p 10000",
    "build": "rimraf dist && vite build",
    "check-exports": "yarn build && npx publint",
    "start": "PORT=10000 next start",
    "lint": "next lint",
    "test": "vitest run && node scripts/test_python.js",
    "test:js": "vitest run",
    "test:python": "node scripts/test_python.js",
    "cli:typescript": "tsx scripts/cli/templates/template.ts",
    "cli:python": "python3 scripts/python/templates/template.py"
  },
  "dependencies": {
    "next": "16.2.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@types/react-dom": "^19.2.3",
    "rimraf": "^6.1.2",
    "rollup-preserve-directives": "^1.1.3",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "ts-node": "^10.9.2",
    "validate-package-exports": "^0.14.0",
    "vite": "^7.2.7",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "^5.1.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.3"
  },
  "packageManager": "yarn@4.12.0"
}
